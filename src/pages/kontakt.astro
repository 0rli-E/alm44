---
import Base from '../layouts/Base.astro';

const title = 'Kontakt — alm44 · Julia und Herbert';
const description = 'Direkter Kontakt zu Julia und Herbert, den Hüttenbetreuern der alm44. Telefon, E-Mail, Standort. Außerteuchen 44, 9562 Himmelberg, Kärnten.';
---
<Base title={title} description={description} navTransparent>
  <!-- Hero ───────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__media">
      <img src="/images/hero-kontakt.jpg" alt="Schlafzimmer-Ecke der alm44 mit Wandbild und warmer Abendlicht" />
    </div>
    <div class="hero__inner">
      <div></div>
      <div>
        <h1 class="hero__title hero__title--logo-color">
          <span class="script">sag</span><br />
          Hallo.
        </h1>
        <div class="hero__meta">
          <span></span>
          <span>Kontakt · Standort</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact ───────────────────────────────────────────────────────── -->
  <section class="section section--lg">
    <div class="wrap kontakt">
      <div data-reveal>
        <span class="eyebrow">Direkt</span>
        <h2 class="kontakt__heading">
          <span class="script">an Julia und Herbert,</span><br />
          die Hüttenbetreuer.
        </h2>
        <dl class="kontakt__list">
          <div>
            <dt>Name</dt>
            <dd>Julia und Herbert</dd>
          </div>
          <div>
            <dt>E-Mail</dt>
            <dd><a href="mailto:alm44@gmx.at?subject=alm44" class="link">alm44@gmx.at</a></dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd><a href="tel:+436643458434" class="link">+43 664 3458434</a></dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd><a href="https://instagram.com/_alm44_" target="_blank" rel="noopener" class="link">_alm44_</a></dd>
          </div>
        </dl>
        <p class="kontakt__hint">
          Gib bei deiner Anfrage gerne den gewünschten Zeitraum, die Anzahl
          der Personen und besondere Wünsche an.
        </p>
      </div>

      <div data-reveal>
        <span class="eyebrow">Standort</span>
        <h2 class="kontakt__heading">
          <span class="script">Außerteuchen 44</span><br />
          AT-9562 Himmelberg.
        </h2>
        <p class="kontakt__lead">
          Mitten in Kärnten, in der Nähe des Ossiachersees, am südlichen
          Rand der Nockberge.
        </p>
        <p style="margin-top: var(--space-md);">
          <a
            href="https://maps.google.com/?q=Außerteuchen+44,+9562+Himmelberg,+Austria"
            target="_blank" rel="noopener" class="btn btn--ghost"
          >In Karten öffnen</a>
        </p>
        <p class="kontakt__hint" style="margin-top: var(--space-md);">
          Die Anreise ist mit dem Auto gut machbar. Die letzten 50 m sind
          ein steiler Schotterweg — bei Schnee empfehlen wir gute Reifen
          oder Allrad. Eine detaillierte Anfahrtsbeschreibung schicken
          wir vor der Anreise.
        </p>
      </div>
    </div>
  </section>

  <!-- Closing line ───────────────────────────────────────────────────── -->
  <section class="section" style="text-align: center; background: var(--c-paper-soft); padding-block: var(--space-lg);">
    <div class="wrap--text" data-reveal>
      <span class="script" style="font-size: clamp(2rem, 4vw + 1rem, 3.5rem); display:block;">bis bald in Kärnten.</span>
    </div>
  </section>
</Base>

<style is:global>
  .hero__title--logo-color,
  .hero__title--logo-color .script { color: #C9A88A; }
</style>

<style>
  .kontakt {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl) clamp(2rem, 6vw, 5rem);
  }
  @media (max-width: 820px) { .kontakt { grid-template-columns: 1fr; } }

  .kontakt__heading {
    font-size: var(--t-h2);
    font-style: italic;
    line-height: 1.05;
    margin-block: var(--space-sm) var(--space-md);
  }
  .kontakt__heading .script {
    display: block;
    font-size: 1.2em;
    line-height: 1;
    margin-bottom: 0.05em;
  }

  .kontakt__list {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
  }
  .kontakt__list > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--c-line);
    padding-top: 0.8em;
    align-items: baseline;
  }
  .kontakt__list dt {
    font-family: var(--f-sans);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-ink-mute);
  }
  .kontakt__list dd { margin: 0; font-size: 1.15rem; }

  .kontakt__lead { font-size: var(--t-lead); color: var(--c-ink-soft); max-width: 36ch; }
  .kontakt__hint { color: var(--c-ink-soft); margin-top: var(--space-md); max-width: 38ch; }
</style>
