---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';

const title = 'alm44 — eine Almhütte in Außerteuchen, Kärnten';
const description = 'Eine Almhütte, neu erzählt. Drei Schlafzimmer, sechs Betten, frisch renoviert. Mitten in Kärnten zwischen Seen und Bergen.';
---
<Base title={title} description={description} navTransparent>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__media">
      <img src="/images/hero-home.jpg" alt="Sonnenuntergang von der Terrasse der alm44 — goldenes Tal, Kärntner Berge im Hintergrund" />
    </div>
    <div class="hero__inner">
      <div></div>
      <div class="hero__bottom">
        <div class="hero__brand-large">alm<span>44</span></div>
        <div class="hero__meta">
          <span>Außerteuchen · Kärnten</span>
          <span>Alpen meets Boho</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section">
    <div class="wrap--text intro" data-reveal>
      <p class="intro__lead">Eine Almhütte, neu erzählt.</p>
      <p>
        Drei Schlafzimmer, sechs Betten, frisch renoviert. Design trifft auf
        handbemalte Möbel und warme Materialien – irgendwo zwischen Alm und
        Boho-Retreat.
      </p>
      <p>
        Draußen eine große Sonnenterrasse, ein wilder Garten mit genug Platz
        für lange Sommertage und Abende unter Sternen.
      </p>

      <hr class="divider intro__divider" />

      <p>
        Die alm44 liegt am Berg, mit weitem Blick über die sanften Hügel
        Kärntens bis zu den Gipfeln der Karawanken. Ein Ort, an dem man
        morgens barfuß ins Gras tritt, nach dem Wandern ins kalte Wasser
        taucht und abends an der Feuerschale sitzt, während langsam Nebel
        durch die Täler zieht.
      </p>
      <p>
        Nah genug für einen Sprung an den Ossiachersee. Weit genug weg,
        damit die Tage wieder langsamer werden.
      </p>
      <p class="intro__close"><em>Ein Ort zum Auftauchen, nicht zum Abhaken.</em></p>
    </div>
  </section>

  <!-- Hütte scenes -->
  <div class="wrap">
    <Scene
      src="/images/wohnen-kachelofen.jpg"
      alt="Kachelofen mit Schaffell-Schaukelstuhl und bemalter Bauerntür im Wohnraum der alm44"
      eyebrow="Wohnen"
      title="im Mittelpunkt."
      reverse
    >
      <p>
        Wenn draußen langsam Nebel über die Hügel zieht und der Abend kühl
        wird, ist das hier der Ort zum Ankommen.
      </p>
      <p>
        Im Schaukelstuhl vor dem alten Kachelofen, mit einem Buch auf den
        Knien, einem Glas Wein in der Hand und dem leisen Knacken des Holzes
        im Hintergrund.
      </p>
    </Scene>

    <Scene
      src="/images/stube.jpg"
      alt="Alter Bauerntisch mit Stillleben und Pendelleuchte in der Stube der alm44"
      eyebrow="Stube"
      title="ein Tisch, an dem man bleibt."
    >
      <p>Der Tisch hat Geschichten gesehen.</p>
      <p>
        Hier ziehen sich Frühstücke bis in den Nachmittag. Es wird gegessen,
        gespielt, gelacht und manchmal stundenlang geredet — über Dinge, für
        die im Alltag oft kein Platz bleibt.
      </p>
    </Scene>

    <Scene
      src="/images/kueche.jpg"
      alt="Schwarze Küchenzeile mit altem Bauernregal, Wandlampen und Krug voller Wiesenblumen"
      eyebrow="Küche"
      title="Kochen mit Weitblick."
      reverse
    >
      <p>
        Eine Küche für langsame Morgen mit frischem Kaffee, für leckere
        Abendessen nach einem langen Tag draußen und für dieses angenehme
        Gefühl, gemeinsam zu kochen, während irgendwo Musik läuft und das
        Fenster noch offen steht.
      </p>
    </Scene>

    <!-- Pull quote -->
    <div class="pullquote" data-reveal>
      <span class="script">Alpen meets Boho</span>
      <p class="eyebrow" style="margin-top: var(--space-sm)">mit Retroflair</p>
    </div>

    <Scene
      src="/images/schlafen-doppelbett.jpg"
      alt="Doppelbett mit Leinenbezug, Bauernbild und Reispapierlampe im Hauptschlafzimmer der alm44"
      eyebrow="Schlafen · 1"
      title="Raum zum Träumen."
    >
      <p>Aufwachen mit Blick auf die Karawanken.</p>
      <p>
        Die ersten Sonnenstrahlen auf den Gipfeln, Nebelschwaden in den
        Tälern und das Gefühl, nirgendwo sein zu müssen. Ein Zimmer für
        alle, die morgens gerne noch einen Moment länger liegen bleiben.
      </p>
    </Scene>

    <Scene
      src="/images/schlafen-truhe.jpg"
      alt="Ruhiges Schlafzimmer mit Einzelbett, weichem Vorhang und einem Blick ins Grüne"
      eyebrow="Schlafen · 2"
      title="Ein Platz für Ruhe."
      reverse
    >
      <p>
        Ein ruhiger Rückzugsort mit Blick ins Grüne. Perfekt für eine
        Person, genauso gemütlich für zwei.
      </p>
      <p>
        Ein Zimmer für lange Nächte nach Tagen voller Bergluft,
        Sonnenstunden und Lagerfeuerabenden.
      </p>
    </Scene>

    <Scene
      src="/images/schlafen-stockbett.jpg"
      alt="Blick ins Stockbettzimmer mit hellem Holzgestell und altem Bauernstuhl"
      eyebrow="Schlafen · 3"
      title="ein Stockbett mit Aussicht."
    >
      <p>
        Manche Erinnerungen entstehen genau in solchen Zimmern: beim
        heimlichen Kichern nach dem Schlafengehen, beim Lesen mit
        Taschenlampe oder beim ersten Blick aus dem Fenster am Morgen.
      </p>
      <p>Klein, gemütlich und gemacht für gemeinsame Ferien.</p>
    </Scene>

    <Scene
      src="/images/bad.jpg"
      alt="Kleines Retrobad mit Steinwaschbecken, gemustertem Wandfliesen und runden Holzspiegel"
      eyebrow="Bad"
      scriptLine="kleines feines"
      title="Retrobad."
      reverse
    >
      <p>
        Die originalen Fliesen aus den 1960er-Jahren durften bleiben. Alles
        andere wurde behutsam erneuert.
      </p>
      <p>
        So verbindet das kleinste Zimmer der Hütte Retrocharme mit modernem
        Komfort – und erzählt ganz nebenbei ein Stück ihrer Geschichte.
      </p>
    </Scene>
  </div>

  <!-- Outdoor -->
  <section class="section section--lg" style="background: var(--c-paper-soft);">
    <div class="wrap">
      <header class="section__header" style="text-align: center; margin-bottom: var(--space-lg);" data-reveal>
        <span class="eyebrow">Draußen</span>
        <h2 style="font-size: var(--t-h1); margin-top: var(--space-sm);">
          <span class="script" style="display:block; font-size: 0.9em; line-height: 1;">unter freiem</span>
          Himmel.
        </h2>
      </header>

      <Scene
        src="/images/terrasse.jpg"
        alt="Ein stiller Ort mit Tageslicht auf der alm44"
        eyebrow="Terrasse"
        title="Der beste Platz."
      >
        <p>
          Man kommt für die Hütte und bleibt für die Terrasse. Für lange
          Sommerabende, gemeinsame Mahlzeiten unter freiem Himmel und
          diesen Blick, der nie ganz alltäglich wird – egal, wie oft man
          ihn sieht.
        </p>
      </Scene>

      <Scene
        src="/images/feuerschale.jpg"
        alt="Zwei Personen sitzen auf einer Bank vor der Feuerschale und blicken auf die abendlichen Berge"
        eyebrow="Feuerschale"
        scriptLine="Lagerfeuerromantik"
        title="wenn der Tag leiser wird."
        reverse
      >
        <p>
          Eine Feuerschale auf der Wiese, eine Bank, der Blick auf den
          Talgrund. Wenn die Sonne hinter den Hängen verschwindet, brennt
          das Feuer noch eine Weile weiter.
        </p>
      </Scene>

      <Scene
        src="/images/quellwasser.jpg"
        alt="Faltbarer Eisbadezuber im Garten der alm44 mit Blick auf die bewölkten Berge"
        eyebrow="Quellwasser"
        title="zum Plantschen oder Eisbaden."
      >
        <p>
          Auf dem Grund der Hütte entspringt eine eigene Quelle. Wir füllen
          damit den Badezuber im Garten — im Sommer angenehm kühl, in der
          Übergangszeit ehrlich kalt.
        </p>
        <p>
          Wer einmal um sechs Uhr morgens im Quellwasser sitzt und den
          Nebel abziehen sieht, versteht, warum manche Gäste deshalb
          wiederkommen.
        </p>
      </Scene>

      <Scene
        src="/images/haengesessel.jpg"
        alt="Schwarzer Hängesessel zwischen zwei alten Apfelbäumen in der Wiese"
        eyebrow="Garten"
        scriptLine="zwischen den Bäumen"
        title="ein Hängesessel, eine Wiese."
        reverse
      >
        <p>
          Zwei alte Bäume, ein Hängesessel dazwischen, eine Wiese, die im
          Mai nach Lavendel riecht. Manchmal kommt eine Kuh vorbei.
        </p>
      </Scene>
    </div>
  </section>

  <!-- Atelier teaser -->
  <section class="section">
    <div class="wrap--text" data-reveal style="text-align: center;">
      <span class="eyebrow">Neu ab Juni 2026</span>
      <h2 style="font-size: var(--t-h2); margin-top: var(--space-sm);">
        <span class="script" style="display:block; font-size: 1.1em;">der Atelierraum</span>
        ein Ort für eigene Projekte.
      </h2>
      <p class="lead" style="margin-top: var(--space-md); margin-inline: auto;">
        Ab Sommer 2026 öffnet auf der alm44 ein eigener Atelierraum für
        kreative Projekte — zum Schreiben, Malen, Werken, Stillsein. Mehr
        Informationen folgen in Kürze.
      </p>
    </div>
  </section>

  <!-- Detail mood gallery -->
  <section class="section section--sm">
    <div class="wrap--wide" data-reveal>
      <div class="gallery">
        <img src="/images/detail-tuer.jpg" alt="Bemalte Bauerntür mit floralem Muster" />
        <img src="/images/detail-kommode.jpg" alt="Vintage Kommode mit Messing-Wandlampe auf schwarzer Holzlamellenwand" />
        <img src="/images/detail-typewriter.jpg" alt="Alte Olympia-Schreibmaschine auf bemalter Bauerntruhe" />
        <img src="/images/detail-bank.jpg" alt="Holzbank mit Krug voller Wiesenblumen vor Holzlamellenwand" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--lg" style="text-align: center;">
    <div class="wrap--text" data-reveal>
      <span class="script" style="font-size: clamp(2.5rem, 5vw + 1rem, 5rem); display: block;">bleib eine Weile.</span>
      <p class="lead" style="margin-top: var(--space-md);">
        Mindestaufenthalt vier Nächte. Ab sieben, zehn oder vierzehn Nächten
        wird's günstiger. Endreinigung, Bettwäsche, Handtücher und Strom
        sind im Preis enthalten.
      </p>
      <p style="margin-top: var(--space-lg);">
        <a href="/buchung/" class="btn">Verfügbarkeit · Preise</a>
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .hero__bottom {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.5vw, 1.4rem);
  }
  .hero__brand-large {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: clamp(4.5rem, 13vw + 1rem, 12rem);
    line-height: 0.85;
    color: #C9A88A;
    text-shadow: 0 1px 2px rgba(0,0,0,0.55), 0 2px 18px rgba(0,0,0,0.55), 0 4px 40px rgba(0,0,0,0.45);
    letter-spacing: -0.02em;
  }
  .hero__brand-large span {
    font-style: italic;
    font-weight: 400;
  }
  .hero .hero__meta {
    font-size: 0.85rem;
    letter-spacing: 0.22em;
  }
  @media (max-width: 640px) {
    .hero .hero__meta { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  }

  .intro__lead {
    font-style: italic;
    font-size: clamp(1.4rem, 1vw + 1.1rem, 1.9rem);
    color: var(--c-ink);
    margin-bottom: var(--space-md);
  }
  .intro p { color: var(--c-ink-soft); line-height: 1.65; }
  .intro p + p { margin-top: 1em; }
  .intro__divider { margin-block: var(--space-lg); }
  .intro__close {
    font-style: italic;
    color: var(--c-ink);
    margin-top: var(--space-md);
  }
</style>
