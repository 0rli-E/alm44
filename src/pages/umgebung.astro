---
import Base from '../layouts/Base.astro';

const title = 'Umgebung — alm44 · Kärnten zwischen Seen und Bergen';
const description = 'Ossiachersee, Turracher Höhe, Gerlitzen, Kletterwald, Therme. Was sich rund um die alm44 in einer halben Stunde erreichen lässt.';

// Each entry: a short editorial scene about a place near the hut.
// Distances are approximate driving distances from Außerteuchen 44.
const places = [
  {
    eyebrow: '10 Minuten talwärts',
    scriptLine: 'der See',
    title: 'Ossiachersee.',
    body: [
      'Der Ossiacher See ist der nächste große Nachbar der alm44. Im Sommer warm genug für lange Badetage, im Frühling und Herbst wunderbar ruhig. Besonders schön: ein Spaziergang am Nordufer entlang nach Ossiach, vorbei an Schilf, Stegen und versteckten Badebuchten. Und danach ein Eis im Café Stift – am besten ohne Eile.',
    ],
  },
  {
    eyebrow: 'direkt vor der Tür',
    scriptLine: 'zu Fuß',
    title: 'Wandern.',
    body: [
      'Die Wege beginnen am Gartentor. Rund um die alm44 laden Wiesenwege, Waldpfade und kleine Straßen dazu ein, einfach loszugehen und die Landschaft in eigenem Tempo zu entdecken.',
      'Und wenn die Wanderstiefel nach mehr verlangen, liegen die Nockberge und die Bergwelt rund um Bad Kleinkirchheim ganz in der Nähe. Sanfte Gipfel, aussichtsreiche Höhenwege und urige Almen machen die Region zu einem Paradies für alle, die gerne zu Fuß unterwegs sind.',
    ],
  },
  {
    eyebrow: '20 Minuten · Bergbahn',
    scriptLine: 'der Hausberg',
    title: 'Gerlitzen Alpe.',
    body: [
      'Die Gerlitzen Alpe ist der Aussichtsberg der Region. Von ihrem Gipfel reicht der Blick über den Ossiacher See, die Nockberge und die Karawanken bis weit über die Grenzen Kärntens hinaus.',
      'Im Sommer locken Wanderwege, Almen und Paragleiter, im Winter ein entspanntes, familiäres Skigebiet mit breiten Pisten.',
      'Unser Tipp: Sonnenuntergang vom Gipfel — einer der schönsten Plätze der Region.',
    ],
  },
  {
    eyebrow: '30 Minuten in die Berge',
    scriptLine: 'höher hinauf',
    title: 'Turracher Höhe.',
    body: [
      'Die Turracher Höhe verbindet Berglandschaft und Familienabenteuer auf besonders schöne Weise. Zwischen Zirbenwäldern und Bergseen warten Wanderwege, der Almzeitpark mit seinen Erlebnisstationen und der Nocky Flitzer für alle, die es etwas schneller mögen.',
      'Dazwischen liegen urige Jausenhütten mit Sonnenterrassen. Hier werden Kärntner Kasnudeln, Brettljausen und hausgemachte Mehlspeisen serviert. Ein Ausflug, bei dem alle auf ihre Kosten kommen.',
    ],
  },
  {
    eyebrow: '25 Minuten am See',
    scriptLine: 'für Kinder · für Mutige',
    title: 'Kletterwald.',
    body: [
      'Im Kletterwald am Ossiacher See geht es von Baum zu Baum, über wackelige Brücken, durch die Baumwipfel und manchmal auch ein kleines Stück über die eigene Komfortzone hinaus.',
      'Und die Geschichten darüber reichen meist bis zum Lagerfeuer am Abend.',
    ],
  },
  {
    eyebrow: '40 Minuten nach Villach',
    scriptLine: 'wenn es regnet',
    title: 'Therme Warmbad.',
    body: [
      'Nicht jeder Urlaubstag braucht Sonnenschein. Manchmal reicht warmes Wasser, ein Saunagang und ein gutes Buch. Die Therme Warmbad in Villach ist schnell erreicht und genau der richtige Ort für Regentage oder müde Beine nach langen Wanderungen.',
      'Und wer Gefallen daran findet, sollte auch die Thermen in Bad Kleinkirchheim besuchen. Dort warten warme Außenbecken, Saunalandschaften und schöne Ausblicke auf die umliegenden Berge.',
    ],
  },
];
---
<Base title={title} description={description} navTransparent>
  <!-- Hero ───────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__media">
      <img src="/images/hero-umgebung.jpg" alt="Weiter Blick über die Hügel und Wälder Kärntens in der Abenddämmerung" />
    </div>
    <div class="hero__inner">
      <div></div>
      <div>
        <h1 class="hero__title hero__title--logo-color">
          <span class="script">mitten in</span><br />
          Kärnten.
        </h1>
        <div class="hero__meta">
          <span></span>
          <span>Seen · Berge · Thermen</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro ──────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="wrap--text" data-reveal>
      <span class="eyebrow">Standort</span>
      <p class="lead" style="margin-top: var(--space-md)">
        Ein Sprung in den Ossiacher See. Wandern in den Nockbergen. Ein
        Nachmittag am Falkert. Eine Jause auf der Alm oder ein Eis am
        Seeufer.
      </p>
      <p style="margin-top: var(--space-md); color: var(--c-ink-soft);">
        Rund um die alm44 liegt vieles von dem, was Kärnten so besonders
        macht. Und manchmal entscheidet man sich trotzdem dafür, einfach
        auf der Terrasse zu bleiben.
      </p>
    </div>
  </section>

  <!-- Places list ─────────────────────────────────────────────────────── -->
  <section class="section section--sm">
    <div class="wrap">
      <ul class="places">
        {places.map((p) => (
          <li class="place" data-reveal>
            <span class="eyebrow">{p.eyebrow}</span>
            <h3 class="place__title">
              {p.scriptLine && <span class="script">{p.scriptLine}</span>}
              {p.title}
            </h3>
            {p.body.map((line) => <p>{line}</p>)}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Image strip ────────────────────────────────────────────────────── -->
  <section class="section section--sm">
    <div class="wrap--wide" data-reveal>
      <div class="gallery gallery--three gallery--three-keep">
        <img src="/images/umgebung-1.jpg" alt="Berg, See und Wolken in Kärnten" />
        <img src="/images/umgebung-2.jpg" alt="Wiesen, Wälder und nebelverhangene Berge in Kärnten" />
        <img src="/images/umgebung-3.jpg" alt="Bergpanorama der Nockberge im Winter" />
      </div>
    </div>
  </section>

  <!-- Closing note ───────────────────────────────────────────────────── -->
  <section class="section section--lg" style="background: var(--c-paper-soft); text-align: center;">
    <div class="wrap--text" data-reveal>
      <span class="script" style="font-size: clamp(2rem, 4vw + 1rem, 3.5rem); display:block;">Genug für einen Sommer. Oder zwei.</span>
      <p class="lead" style="margin-top: var(--space-md);">
        Berge, Seen, Almen, Aussichtspunkte und kleine Orte voller
        Geschichten. Rund um die alm44 gibt es mehr zu entdecken, als in
        einen Urlaub passt. Zum Glück. Denn das gibt immer einen guten
        Grund, wiederzukommen.
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .hero__title--logo-color { color: #C9A88A; }
  .hero__title--logo-color .script { color: #C9A88A; }
</style>

<style>
  /* Bilderreihe immer 3-spaltig und zentriert — auch in der mobilen Ansicht. */
  .gallery--three-keep {
    grid-template-columns: repeat(3, 1fr) !important;
    max-width: 980px;
    margin-inline: auto;
    justify-content: center;
    gap: clamp(0.4rem, 1.4vw, 1.2rem);
  }
  .gallery--three-keep img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .places {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) clamp(2rem, 5vw, 4rem);
    list-style: none;
    padding: 0;
  }
  @media (max-width: 720px) {
    .places { grid-template-columns: 1fr; gap: var(--space-md); }
  }
  .place {
    border-top: 1px solid var(--c-line);
    padding-top: var(--space-md);
  }
  .place__title {
    font-size: var(--t-h3);
    font-style: italic;
    margin-block: var(--space-sm) var(--space-md);
  }
  .place__title .script {
    display: block;
    font-size: 1.2em;
    line-height: 1;
    margin-bottom: 0.05em;
  }
  .place p { color: var(--c-ink-soft); }
  .place p + p { margin-top: 0.7em; }
</style>
