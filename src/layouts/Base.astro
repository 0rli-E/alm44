---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  navTransparent?: boolean;
}

const {
  title = 'alm44 — eine kleine Hütte in Außerteuchen, Kärnten',
  description = 'Frisch renoviert. Alpen meets Boho. Eine kleine Hütte mit großem Blick — nahe Ossiachersee, mitten in Kärnten.',
  ogImage = '/og.jpg',
  navTransparent = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EFE7DC" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="de_AT" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon (TODO: replace with real icon set) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Nav transparent={navTransparent} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal on scroll — IntersectionObserver
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
        items.forEach(el => io.observe(el));
      } else {
        items.forEach(el => el.classList.add('is-in'));
      }
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        background: var(--c-ink);
        color: var(--c-cream);
        padding: 0.6em 1em;
        font-family: var(--f-sans);
        font-size: 0.9rem;
        z-index: 100;
        transition: top 200ms var(--ease);
      }
      .skip-link:focus { top: 0; }
    </style>
  </body>
</html>
